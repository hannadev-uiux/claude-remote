{
  "functions": [
    {
      "source": "apps/push-relay/deploy",
      "codebase": "push-relay",
      "runtime": "nodejs22",
      "predeploy": [
        "pnpm --filter @remote-harness/push-relay build",
        "npm --prefix \"$RESOURCE_DIR\" install --omit dev --no-audit --no-fund --no-package-lock"
      ],
      "ignore": ["node_modules", ".git", "*.local", "firebase-debug.log"]
    }
  ]
}
